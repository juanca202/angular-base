/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/version-info": ["test/mocks/version-info.ts"],
      "@factor_ec/ui": ["test/mocks/factor-ui.ts"],
      "@factor_ec/utils": ["test/mocks/factor-utils.ts"],
      "apollo-angular": ["test/mocks/apollo-angular.ts"],
      "@sentry/angular": ["test/mocks/sentry-angular.ts"],
      "version-info": ["test/mocks/version-info.ts"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "setup-vitest.ts"]
}
