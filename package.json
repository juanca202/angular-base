{
  "name": "angular-base-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node git-version.js && ng serve",
    "build": "node git-version.js && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "e2e": "ng e2e",
    "extract-i18n": "ng extract-i18n --out-file public/i18n/en.json --format=json && node generate-i18n.js",
    "i18n": "node generate-i18n.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{ts,js,html,scss,json,md}\" --write",
    "prettier:check": "prettier \"**/*.{ts,js,html,scss,json,md}\" --check",
    "prepare": "husky",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s",
    "icons:pack": "node generate-icons.js"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "lint-staged": {
    "src/**/*.{ts,js,html,scss,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@angular/cdk": "~21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/material": "~21.0.6",
    "@angular/platform-browser": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@angular/service-worker": "^21.0.8",
    "@factor_ec/ui": "^5.0.8",
    "@factor_ec/utils": "^5.0.8",
    "@microsoft/applicationinsights-web": "^3.3.10",
    "git-describe": "^4.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/schematics": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@angular/localize": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@compodoc/compodoc": "^1.1.32",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "baseline-browser-mapping": "^2.9.2",
    "cheerio": "^1.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fs-extra": "^11.3.3",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "playwright": "^1.57.0",
    "playwright-ng-schematics": "^21.0.3",
    "postcss": "^8.5.3",
    "prettier": "^3.3.3",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
