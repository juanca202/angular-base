{
  "name": "angular-base-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node git-version.js && ng serve",
    "build": "node git-version.js && ng build && cp docker/docker-compose.yml docker/nginx.conf dist/angular-base-project/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "node git-version.js && ng test --watch=false",
    "test:coverage": "ng test --coverage",
    "e2e": "ng e2e",
    "extract-i18n": "ng extract-i18n --out-file public/i18n/en.json --format=json && node scripts/generate-i18n.js",
    "i18n": "node scripts/generate-i18n.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{ts,js,html,scss,json,md}\" --write",
    "prettier:check": "prettier \"**/*.{ts,js,html,scss,json,md}\" --check",
    "prepare": "husky",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s",
    "icons:pack": "node scripts/generate-icons.js"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "lint-staged": {
    "src/**/*.{ts,js,html,scss,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@angular/cdk": "~22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/material": "~22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@angular/service-worker": "^22.0.6",
    "@factor_ec/ui": "^6.0.0",
    "@factor_ec/utils": "^6.0.4",
    "git-describe": "^4.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/localize": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@compodoc/compodoc": "^1.2.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.3.5",
    "happy-dom": "^20.10.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^15.5.2",
    "ng-packagr": "^22.0.1",
    "playwright": "^1.60.0",
    "playwright-ng-schematics": "^21.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
