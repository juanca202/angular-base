{
  "name": "angular-base-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node git-version.js && ng serve",
    "build": "node git-version.js && ng build && npm run sentry:sourcemaps",
    "extract-i18n": "ng extract-i18n --out-file public/i18n/en.json --format=json && node generate-i18n.js",
    "i18n": "node generate-i18n.js",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org factor-ec --project angular-base-project ./dist && sentry-cli sourcemaps upload --org factor-ec --project angular-base-project ./dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{ts,js,html,scss,json,md}\" --write",
    "prepare": "husky",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s"
  },
  "lint-staged": {
    "src/**/*.{ts,js,html,scss,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~20.2.4",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/material": "~20.2.4",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@factor_ec/ui": "^5.0.8",
    "@factor_ec/utils": "^5.0.8",
    "@sentry/angular": "^9.28.1",
    "@sentry/cli": "^2.46.0",
    "apollo-angular": "^11.0.0",
    "git-describe": "^4.1.1",
    "moment": "^2.30.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.3.0",
    "@angular-eslint/eslint-plugin-template": "^20.3.0",
    "@angular-eslint/schematics": "^20.3.0",
    "@angular-eslint/template-parser": "^20.3.0",
    "@angular/build": "^20.3.2",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/localize": "^20.3.1",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@compodoc/compodoc": "^1.1.32",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "babel-jest": "^30.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-preset-angular": "^15.0.1",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
