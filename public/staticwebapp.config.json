{
  "routes": [
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{js,css,woff,woff2,ttf,eot,svg,png,jpg,webp,ico}",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,png,jpg,svg,webp,ico,woff,woff2,ttf,eot}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
